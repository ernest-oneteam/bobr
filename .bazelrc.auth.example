# Remote-cache credentials — TEMPLATE.
#
# Copy this file to .bazelrc.auth (which is git-ignored) and fill in your key:
#     cp .bazelrc.auth.example .bazelrc.auth
#
# .bazelrc loads it automatically via `try-import %workspace%/.bazelrc.auth`,
# and it only takes effect when you build with `--config=remote` (read+write)
# or `--config=remote-ro` (read-only, for untrusted PR builds).
#
# BuildBuddy: create a key at https://app.buildbuddy.io/  ->  Setup.
# Other backends: replace the header below with whatever auth they expect
# (e.g. `--google_default_credentials` for a GCS bucket, or no header at all
# for an unauthenticated self-hosted bazel-remote).
build:remote --remote_header=x-buildbuddy-api-key=REPLACE_WITH_YOUR_KEY
